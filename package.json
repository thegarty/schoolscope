{
  "name": "schoolscope",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node server.js",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "railway:deploy": "prisma migrate deploy && npm run db:seed:safe",
    "db:seed:safe": "tsx prisma/seed.ts --if-empty",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "make-admin": "node scripts/make-admin.js",
    "typecheck": "tsc --noEmit",
    "test:auth-smoke": "node scripts/auth-smoke.mjs",
    "tutor:controller": "tsx scripts/tutoring/controller.ts",
    "dev:all": "node scripts/tutoring/dev.mjs",
    "tutor:prepare": "pnpm db:migrate:deploy && pnpm db:seed:safe",
    "tutor:web": "pnpm tutor:prepare && next start --hostname 0.0.0.0 --port 3000",
    "test:tutor": "tsx --test scripts/tutoring/contracts.test.ts",
    "test:tutor:db": "tsx --test scripts/tutoring/database.test.ts",
    "test:tutor:public": "node scripts/tutoring/public-smoke.mjs",
    "tutor:admin": "tsx scripts/tutoring/admin.ts"
  },
  "dependencies": {
    "@allauth/react": "file:vendor/allauth-react-1.4.4.tgz",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/client-ses": "^3.1018.0",
    "@aws-sdk/client-sns": "^3.1018.0",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tailwindcss/postcss": "^4.2.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.575.0",
    "next": "^16.2.1",
    "openai": "^7.52.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "resend": "^6.9.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.22.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.5.8",
    "prisma": "^7.5.0",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
